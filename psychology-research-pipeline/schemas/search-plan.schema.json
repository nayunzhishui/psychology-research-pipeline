{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search-plan.schema.json",
  "title": "Modular evidence search plan",
  "type": "object",
  "required": ["schema_version", "review_id", "concept_blocks", "query_families", "languages", "search_update_days"],
  "properties": {
    "schema_version": {"const": 1},
    "review_id": {"type": "string", "minLength": 1},
    "concept_blocks": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    },
    "query_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["family_id", "purpose", "blocks", "queries"],
        "properties": {
          "family_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "purpose": {"type": "string", "minLength": 1},
          "blocks": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "queries": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "database_protocols": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["platform", "access_status", "export_format", "syntax_status"],
        "properties": {
          "platform": {"type": "string", "minLength": 1},
          "access_status": {"enum": ["available", "institutional-login-required", "unverified", "unavailable"]},
          "export_format": {"type": "string", "minLength": 1},
          "syntax_status": {"enum": ["draft", "live-verified"]}
        },
        "additionalProperties": false
      }
    },
    "eligibility": {
      "type": "object",
      "required": ["date_range", "publication_types", "population", "include", "exclude"],
      "properties": {
        "date_range": {"type": "string", "minLength": 1},
        "publication_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "population": {"type": "string", "minLength": 1},
        "include": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exclude": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "zotero_target": {
      "type": "object",
      "required": ["collection_name", "collection_key"],
      "properties": {
        "collection_name": {"type": "string", "minLength": 1},
        "collection_key": {"type": "string", "pattern": "^[A-Z0-9]{8}$"}
      },
      "additionalProperties": false
    },
    "quality_assurance": {
      "type": "object",
      "required": ["deduplication", "screening", "retraction_check", "supplemental_search"],
      "properties": {
        "deduplication": {"type": "string", "minLength": 1},
        "screening": {"type": "string", "minLength": 1},
        "retraction_check": {"type": "string", "minLength": 1},
        "supplemental_search": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "search_update_days": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
