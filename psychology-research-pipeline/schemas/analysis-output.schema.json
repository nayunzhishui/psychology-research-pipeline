{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis-output.schema.json",
  "title": "Verified model-output interchange",
  "type": "object",
  "required": ["schema_version", "analysis_id", "sample_n", "primary_model", "estimator", "converged", "post_check", "fit", "parameters", "deviations", "diagnostics"],
  "properties": {
    "schema_version": {"const": 1},
    "analysis_id": {"type": "string"},
    "sample_n": {"type": "integer", "minimum": 1},
    "converged": {"const": true},
    "post_check": {"const": true},
    "parameters": {"type": "array", "minItems": 1},
    "deviations": {"type": "array"}
  }
}
