{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis-spec.schema.json",
  "title": "Longitudinal analysis specification",
  "type": "object",
  "required": ["schema_version", "status", "blocking_items", "waves", "constructs", "measurement_mode"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["draft", "blocked", "frozen"]},
    "blocking_items": {
      "type": "array",
      "items": {
        "anyOf": [
          {"type": "string", "minLength": 1},
          {"type": "object", "minProperties": 1}
        ]
      }
    },
    "waves": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "constructs": {"type": "object", "minProperties": 2},
    "measurement_mode": {"enum": ["score-comparability", "item-level"]},
    "group_variable": {"type": ["string", "null"]},
    "group_labels": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "sex_measurement_invariance": {
      "type": "object",
      "properties": {
        "required_level": {"enum": ["metric", "scalar"]},
        "max_abs_delta_cfi": {"type": "number", "minimum": 0},
        "max_increase_rmsea": {"type": "number", "minimum": 0},
        "max_increase_srmr": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "cluster_variable": {"type": ["string", "null"]},
    "estimator": {"type": "string"},
    "missing": {"type": "string"}
  }
}
