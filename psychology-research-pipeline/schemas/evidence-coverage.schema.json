{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-coverage.schema.json",
  "title": "Evidence coverage requirements",
  "type": "object",
  "required": ["schema_version", "requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slot_id", "core", "minimum", "criteria"],
        "properties": {
          "slot_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "core": {"type": "boolean"},
          "minimum": {"type": "integer", "minimum": 1},
          "criteria": {
            "type": "object",
            "properties": {
              "evidence_role": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "constructs_all": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "design_any": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "retraction_status": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "fulltext_status": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
