{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "presearch-protocol.schema.json",
  "title": "Pre-search empirical psychology protocol",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "title",
    "purpose",
    "study",
    "estimands",
    "research_questions",
    "hypotheses",
    "constructs",
    "analysis_families",
    "inference_boundaries",
    "reporting",
    "ethics",
    "open_science",
    "search_protocol",
    "unresolved_items",
    "approval"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "protocol_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "purpose": {"enum": ["journal-article", "thesis", "grant", "other"]},
    "study": {
      "type": "object",
      "required": ["design", "population", "setting", "waves", "wave_timing", "sample"],
      "properties": {
        "design": {"type": "string", "minLength": 1},
        "population": {"type": "string", "minLength": 1},
        "setting": {"type": "string", "minLength": 1},
        "waves": {"type": "array", "minItems": 2, "items": {"type": "string"}, "uniqueItems": true},
        "wave_timing": {"$ref": "#/$defs/fact"},
        "sample": {
          "type": "object",
          "required": ["observed_rows", "interpretation", "recruitment", "inclusion", "exclusion", "status"],
          "properties": {
            "observed_rows": {"type": ["integer", "null"], "minimum": 1},
            "interpretation": {"type": "string", "minLength": 1},
            "recruitment": {"type": "string", "minLength": 1},
            "inclusion": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "exclusion": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "status": {"enum": ["confirmed", "provisional", "unverified"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "estimands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tieredStatement"}},
    "research_questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tieredStatement"}},
    "hypotheses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tieredStatement"}},
    "constructs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["construct_id", "label", "role", "waves", "variables", "instrument", "scoring", "status"],
        "properties": {
          "construct_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "label": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "waves": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "variables": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
          "instrument": {"type": "string", "minLength": 1},
          "scoring": {"type": "string", "minLength": 1},
          "status": {"enum": ["confirmed", "provisional", "unverified"]}
        },
        "additionalProperties": false
      }
    },
    "analysis_families": {
      "type": "object",
      "required": ["primary", "secondary", "sensitivity", "exploratory", "multiplicity"],
      "properties": {
        "primary": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "secondary": {"type": "array", "items": {"type": "string"}},
        "sensitivity": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exploratory": {"type": "array", "items": {"type": "string"}},
        "multiplicity": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "inference_boundaries": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reporting": {
      "type": "object",
      "required": ["study_class", "standards", "target_journal", "policy_status"],
      "properties": {
        "study_class": {"type": "string", "minLength": 1},
        "standards": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "target_journal": {"type": "string", "minLength": 1},
        "policy_status": {"enum": ["pending-live-verification", "verified"]}
      },
      "additionalProperties": false
    },
    "ethics": {
      "type": "object",
      "required": ["approval_status", "approval_id", "consent_status", "assent_status", "risk_protocol_status", "known_facts", "unknowns"],
      "properties": {
        "approval_status": {"enum": ["verified", "unverified", "not-applicable"]},
        "approval_id": {"type": "string"},
        "consent_status": {"enum": ["verified", "unverified", "not-applicable"]},
        "assent_status": {"enum": ["verified", "unverified", "not-applicable"]},
        "risk_protocol_status": {"enum": ["verified", "unverified", "not-applicable"]},
        "known_facts": {"type": "array", "items": {"type": "string"}},
        "unknowns": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "open_science": {
      "type": "object",
      "required": ["preregistration", "data_sharing", "code_sharing", "materials_sharing", "deviation_policy"],
      "properties": {
        "preregistration": {"type": "string", "minLength": 1},
        "data_sharing": {"type": "string", "minLength": 1},
        "code_sharing": {"type": "string", "minLength": 1},
        "materials_sharing": {"type": "string", "minLength": 1},
        "deviation_policy": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "search_protocol": {
      "type": "object",
      "required": ["databases", "languages", "date_range", "include", "exclude", "supplemental_methods", "screening_plan"],
      "properties": {
        "databases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "date_range": {"type": "string", "minLength": 1},
        "include": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exclude": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "supplemental_methods": {"type": "array", "items": {"type": "string"}},
        "screening_plan": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "unresolved_items": {"type": "array", "items": {"$ref": "#/$defs/unresolvedItem"}},
    "approval": {
      "type": "object",
      "required": ["scope_status", "protocol_status", "approved_by", "approved_at"],
      "properties": {
        "scope_status": {"enum": ["draft", "approved"]},
        "protocol_status": {"enum": ["draft", "frozen"]},
        "approved_by": {"type": "string"},
        "approved_at": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["status", "value", "source"],
      "properties": {
        "status": {"enum": ["confirmed", "provisional", "unverified"]},
        "value": {"type": "string"},
        "source": {"type": "string"}
      },
      "additionalProperties": false
    },
    "tieredStatement": {
      "type": "object",
      "required": ["id", "tier", "text", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "tier": {"enum": ["primary", "secondary", "exploratory"]},
        "text": {"type": "string", "minLength": 1},
        "status": {"enum": ["confirmed", "provisional", "unverified"]}
      },
      "additionalProperties": false
    },
    "unresolvedItem": {
      "type": "object",
      "required": ["id", "category", "severity", "status", "blocking_stages", "question", "resolution_evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "severity": {"enum": ["blocking", "major", "minor"]},
        "status": {"enum": ["open", "resolved"]},
        "blocking_stages": {"type": "array", "items": {"enum": ["00_scope", "01_protocol", "02_search", "05_methods", "06_data", "07_analysis", "09_manuscript", "11_review"]}},
        "question": {"type": "string", "minLength": 1},
        "resolution_evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
