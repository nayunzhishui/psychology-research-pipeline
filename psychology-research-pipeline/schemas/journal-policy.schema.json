{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "journal-policy.schema.json",
  "title": "Official journal-policy evidence",
  "type": "object",
  "required": ["journal", "article_type", "checked_at", "scope_fit", "word_limit", "ai_policy", "data_policy", "official_domains", "submission_url", "source_urls", "source_snapshots"],
  "properties": {
    "checked_at": {"type": "string", "format": "date"},
    "official_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "submission_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "source_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
    "source_snapshots": {"type": "array", "minItems": 1}
  }
}
