{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zotero-target.schema.json",
  "title": "Exact Zotero collection target",
  "type": "object",
  "required": ["schema_version", "library", "collection_name", "collection_key", "verified_at", "initial_item_count"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "library": {"const": "users/0"},
    "collection_name": {"type": "string", "minLength": 1},
    "collection_key": {"type": "string", "pattern": "^[A-Z0-9]{8}$"},
    "verified_at": {"type": "string", "format": "date-time"},
    "initial_item_count": {"type": "integer", "minimum": 0},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
